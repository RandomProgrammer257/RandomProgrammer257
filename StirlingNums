#include <iostream>
#include <stdlib.h>
#include <limits>
#define SIZE 1000+1
using namespace std;

int ki, ni;

int main(int argc, char *argv[])
{
	cout<< "введите параметр n для числа стирлинга:\n";
		cin>>ni;
	cout<< "введите параметр k для числа стирлинга:\n";
	cin>>ki;
	
		int mass[SIZE][SIZE];
		for(int n=0;n<SIZE;n++){
	    for(int k=0;k<SIZE;k++){
	        mass[k][n]=0;
	    }

	}

	
	
	
	for(int n=0;n<SIZE;n++){
	    for(int k=0;k<SIZE;k++){
  mass[k][n] = mass[k-1][n-1] + k*mass[k][n-1];
	 if(n==k){mass[k][n]=1;}
	 else if(k>n){mass[k][n]=0;}
	 else if(k==0){mass[k][n]=0;}
	  
	 
	    }
	}
	
	        cout<<"число разбиений множества n на k блоков:" <<mass[ki][ni]<< "\t";
	    
	

